# Cloudflare Pages custom headers
# HTML: no-cache so the shell always picks up new script tags
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# JS / CSS: short cache, we'll bust with URL ?v= when needed
/*.js
  Cache-Control: public, max-age=300, must-revalidate

/*.css
  Cache-Control: public, max-age=300, must-revalidate
